{
	"name": "n8n-nodes-words-into-music",
	"version": "0.1.0",
	"description": "n8n community node for the Words into Music API: prepare and start AI songs from ideas or lyrics, check generation status, browse your song library and check song credits.",
	"license": "MIT",
	"homepage": "https://wordsintomusic.com/developers/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"words-into-music",
		"ai-music",
		"ai-song-generator",
		"lyrics-to-song",
		"music-api"
	],
	"author": {
		"name": "Words into Music",
		"email": "contact@wordsintomusic.com",
		"url": "https://wordsintomusic.com/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/constantinginga/n8n-nodes-words-into-music.git"
	},
	"bugs": {
		"url": "https://github.com/constantinginga/n8n-nodes-words-into-music/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WordsIntoMusicApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/WordsIntoMusic/WordsIntoMusic.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
